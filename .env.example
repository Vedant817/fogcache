# Copy to `.env` and adjust for your machine. All values have sane local defaults
# (documented in the comments below), so a bare `docker compose up -d` works out of
# the box. Never commit `.env`.

# --- PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_DB=fogcache
POSTGRES_USER=fogcache
POSTGRES_PASSWORD=fogcache_dev_password

# --- Redis ---
REDIS_PORT=6379

# --- Kafka (KRaft single node) ---
KAFKA_PORT=9092

# --- MinIO (API + console) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=fogcache
MINIO_ROOT_PASSWORD=fogcache_dev_password

# --- Keycloak (local OIDC; realm "fogcache" imported on first start) ---
KEYCLOAK_PORT=8088
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=fogcache_dev_password

# --- Service ports (compose.services.yaml) ---
ROUTING_PORT=8080
EDGE_1_PORT=8081
EDGE_2_PORT=8082
CONTENT_PORT=8083
CONTROL_PORT=8084
ANALYTICS_PORT=8085

# --- Telemetry ---
TRACE_SAMPLING_PROBABILITY=1.0
