<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!--
	    Adds the OpenTelemetry Logback appender to the default Boot setup
	    (console + file). The appender is only active when the OTel log
	    export pipeline is configured (management.opentelemetry.logging.*);
	    the OpenTelemetry instance is registered at startup by
	    OpenTelemetryAppenderInitializer from fogcache-common.
	-->
	<include resource="org/springframework/boot/logging/logback/base.xml"/>
	<appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender"/>
	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="FILE"/>
		<appender-ref ref="OTEL"/>
	</root>
</configuration>
