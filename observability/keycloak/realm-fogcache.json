{
  "realm": "fogcache",
  "displayName": "FogCache Local",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to dashboards, logs, and metrics"
      },
      {
        "name": "operator",
        "description": "Operate cache nodes, drain, and trigger invalidations"
      },
      {
        "name": "tenant-admin",
        "description": "Manage a tenant's origins, policies, and quotas"
      },
      {
        "name": "platform-admin",
        "description": "Full administrative access to the platform"
      },
      {
        "name": "auditor",
        "description": "Read-only access to audit logs and compliance data"
      }
    ]
  },
  "clients": [
    {
      "clientId": "fogcache-admin-web",
      "name": "FogCache Admin Web",
      "description": "Browser client for the admin web console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "protocol": "openid-connect"
    },
    {
      "clientId": "fogcache-routing",
      "name": "FogCache Routing Service",
      "description": "Service account for the routing service (local only)",
      "enabled": true,
      "publicClient": false,
      "secret": "fogcache_dev_secret_routing",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "fogcache-edge",
      "name": "FogCache Edge Service",
      "description": "Service account for edge nodes (local only)",
      "enabled": true,
      "publicClient": false,
      "secret": "fogcache_dev_secret_edge",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "fogcache-content",
      "name": "FogCache Content Service",
      "description": "Service account for the content origin service (local only)",
      "enabled": true,
      "publicClient": false,
      "secret": "fogcache_dev_secret_content",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "fogcache-control",
      "name": "FogCache Control Service",
      "description": "Service account for the control service (local only)",
      "enabled": true,
      "publicClient": false,
      "secret": "fogcache_dev_secret_control",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "fogcache-analytics",
      "name": "FogCache Analytics Service",
      "description": "Service account for the analytics service (local only)",
      "enabled": true,
      "publicClient": false,
      "secret": "fogcache_dev_secret_analytics",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "viewer",
      "email": "viewer@fogcache.dev",
      "firstName": "Viewer",
      "lastName": "Local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "fogcache_dev_password",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"]
    },
    {
      "username": "operator",
      "email": "operator@fogcache.dev",
      "firstName": "Operator",
      "lastName": "Local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "fogcache_dev_password",
          "temporary": false
        }
      ],
      "realmRoles": ["operator"]
    },
    {
      "username": "tenant-admin",
      "email": "tenant-admin@fogcache.dev",
      "firstName": "Tenant",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "fogcache_dev_password",
          "temporary": false
        }
      ],
      "realmRoles": ["tenant-admin"]
    },
    {
      "username": "platform-admin",
      "email": "platform-admin@fogcache.dev",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "fogcache_dev_password",
          "temporary": false
        }
      ],
      "realmRoles": ["platform-admin"]
    },
    {
      "username": "auditor",
      "email": "auditor@fogcache.dev",
      "firstName": "Auditor",
      "lastName": "Local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "fogcache_dev_password",
          "temporary": false
        }
      ],
      "realmRoles": ["auditor"]
    }
  ]
}
